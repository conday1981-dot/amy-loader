{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AMY Loader",
  "mainBinaryName": "AMY Loader",
  "version": "1.0.1",
  "identifier": "uk.amy.loader",
  "app": {
    "windows": [
      {
        "title": "A.M.Y Loader",
        "width": 1040,
        "height": 720,
        "minHeight": 520,
        "minWidth": 760
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": false,
    "shortDescription": "A.M.Y Loader \u2014 sideload apps to your iPhones",
    "copyright": "A.M.Y Loader by Con. Built on iloader by nab138 (MIT).",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "amy-icons/32x32.png",
      "amy-icons/128x128.png",
      "amy-icons/128x128@2x.png",
      "amy-icons/icon.icns",
      "amy-icons/icon.ico"
    ]
  }
}
